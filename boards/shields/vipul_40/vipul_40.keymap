#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/outputs.h>

/ {
    combos {
        compatible = "zmk,combos";

        /* Press Tab + Q (top left 2 keys) together to Clear BT bond */
        combo_bt_clr {
            timeout-ms = <50>;
            key-positions = <0 1>;
            bindings = <&bt BT_CLR>;
        };

        /* Press LCtrl + LAlt (bottom left 2 keys) together to Select Profile 0 */
        combo_bt_sel0 {
            timeout-ms = <50>;
            key-positions = <36 37>;
            bindings = <&bt BT_SEL 0>;
        };

        /* Home row combos: { [ ] } */
        combo_lbrace {
            timeout-ms = <50>;
            key-positions = <14 15>;
            bindings = <&kp LBRC>;
        };

        combo_lbkt {
            timeout-ms = <50>;
            key-positions = <15 16>;
            bindings = <&kp LBKT>;
        };

        combo_rbkt {
            timeout-ms = <50>;
            key-positions = <19 20>;
            bindings = <&kp RBKT>;
        };

        combo_rbrace {
            timeout-ms = <50>;
            key-positions = <20 21>;
            bindings = <&kp RBRC>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
                &kp TAB       &kp Q     &kp W     &kp E      &kp R      &kp T      &kp Y      &kp U     &kp I      &kp O     &kp P     &kp BSPC
                &kp ESC       &kp A     &kp S     &kp D      &kp F      &kp G      &kp H      &kp J     &kp K      &kp L     &kp SEMI  &kp RET
                &kp LSHFT     &kp Z     &kp X     &kp C      &kp V      &kp B      &kp N      &kp M     &kp COMMA  &kp DOT   &kp FSLH  &mo 2
                &kp LCTRL     &kp LALT  &kp LGUI  &mo 1      &kp SPACE  &bt BT_CLR &out OUT_TOG &kp LEFT &kp DOWN   &kp UP    &kp RIGHT &bt BT_SEL 0
            >;
        };

        fn_layer {
            bindings = <
                &kp GRAVE     &kp N1    &kp N2    &kp N3     &kp N4     &kp N5     &kp N6     &kp N7    &kp N8     &kp N9    &kp N0    &kp DEL
                &kp CAPSLOCK  &kp MINUS &kp EQUAL &kp LBKT   &kp RBKT   &kp BSLH   &kp APOSTROPHE &trans    &trans     &trans    &trans    &trans
                &bt BT_CLR    &bt BT_SEL 0 &bt BT_SEL 1 &bt BT_SEL 2 &trans &trans &trans   &trans    &trans     &trans    &trans    &trans
                &trans        &trans    &trans    &trans     &trans     &trans     &trans     &trans    &trans     &trans    &trans    &trans
            >;
        };

        fn2_layer {
            bindings = <
                &kp F1        &kp F2    &kp F3    &kp F4     &kp F5     &kp F6     &kp F7     &kp F8    &kp F9     &kp F10   &kp F11   &kp F12
                &trans        &trans    &trans    &trans     &trans     &trans     &trans     &trans    &trans     &trans    &trans    &kp DEL
                &trans        &trans    &trans    &trans     &trans     &trans     &trans     &trans    &trans     &trans    &trans    &trans
                &trans        &trans    &trans    &trans     &trans     &trans     &trans     &kp END  &kp PG_DN   &kp PG_UP &kp INS   &trans
            >;
        };
    };
};